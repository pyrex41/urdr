class GateFailure(Exception):
    """A strict gate contract was not met."""

    def __init__(self, message: str, exit_code: int = 1) -> None:
        super().__init__(message)
        self.exit_code = exit_code


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def load_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise GateFailure(f"cannot read {path.relative_to(ROOT)}: {error}", 2) from error
    if not isinstance(value, dict):
        raise GateFailure(f"{path.relative_to(ROOT)} must contain a JSON object", 2)
    return value


def parse_required_impls(value: str) -> tuple[str, ...]:
    """Parse REQUIRED_IMPLS: non-empty subset of the four reviewed ports.

    Default CI uses all four. Single-port development (e.g. ``shen-cl``)
    is allowed so M1 can advance while slower ports are investigated
    separately; lock pins for unused ports are still validated.
    """
    names = tuple(part.strip() for part in value.split(",") if part.strip())
    if not names:
        raise GateFailure("required implementation matrix is empty")
    if len(names) != len(set(names)):
        raise GateFailure("required implementation matrix contains duplicate ports")
    unknown = [name for name in names if name not in REQUIRED_IMPLS]
    if unknown:
        raise GateFailure(
            "unknown required port(s): "
            + ",".join(unknown)
            + " (allowed: "
            + ",".join(REQUIRED_IMPLS)
            + ")"
        )
    # Stable order matching REQUIRED_IMPLS, not the env string order.
    return tuple(name for name in REQUIRED_IMPLS if name in set(names))


def load_and_validate_locks() -> dict[str, dict[str, Any]]:
    tools = load_json(ROOT / "build" / "locks" / "tools.lock.json")
    ports = load_json(ROOT / "build" / "locks" / "shen-ports.lock.json")
    if set(tools) != {"schema_version", "tools"} or tools.get("schema_version") != 1:
        raise GateFailure("tools lock does not match strict schema version 1", 2)
    if (
        set(ports) != {"schema_version", "kernel_version", "ports"}
        or ports.get("schema_version") != 1
        or ports.get("kernel_version") != KERNEL_VERSION
    ):
        raise GateFailure("Shen ports lock does not pin kernel 41.2", 2)

    entries: dict[str, dict[str, Any]] = {}
    raw_entries = list(tools.get("tools", [])) + list(ports.get("ports", []))
    for item in raw_entries:
        if not isinstance(item, dict) or not isinstance(item.get("name"), str):
            raise GateFailure("dependency lock contains a malformed entry", 2)
        name = item["name"]
        if name in entries:
            raise GateFailure(f"dependency {name} is pinned more than once", 2)
        entries[name] = item
    if set(entries) != set(EXPECTED_PINS):
        raise GateFailure("dependency lock names differ from the reviewed matrix", 2)
    for name, expected in EXPECTED_PINS.items():
        item = entries[name]
        if item.get("commit") != expected or not FULL_SHA.fullmatch(
            str(item.get("commit", ""))
        ):
            raise GateFailure(f"{name} lock commit differs from reviewed pin", 2)
        if item.get("destination") != name:
            raise GateFailure(f"{name} lock destination must be {name}", 2)
        if name in REQUIRED_IMPLS and (
            item.get("required") is not True
            or item.get("kernel_version") != KERNEL_VERSION
        ):
            raise GateFailure(f"{name} must be required at kernel 41.2", 2)
    if entries["shenscript"].get("required") is not False:
        raise GateFailure("ShenScript must remain optional", 2)
    return entries


def validate_manifest(manifest: dict[str, Any]) -> list[dict[str, Any]]:
    if set(manifest) != {
        "schema_version",
        "name",
        "root",
        "default_cwd",
        "cases",
    }:
        raise GateFailure("suite manifest fields differ from production contract", 2)
    if (
        manifest.get("schema_version") != 1
        or manifest.get("name") != "urdr-m0-production-conformance"
        or manifest.get("root") != "."
        or manifest.get("default_cwd") != "."
    ):
        raise GateFailure("suite manifest identity or root changed", 2)
    cases = manifest.get("cases")
    if not isinstance(cases, list) or len(cases) != len(CASE_ORDER):
        raise GateFailure("suite must contain canonical, PRNG, and world cases", 2)
    for index, name in enumerate(CASE_ORDER):
        case = cases[index]
        if not isinstance(case, dict) or case.get("name") != name:
            raise GateFailure(f"suite case order or identity changed at {name}", 2)
        if "marker" not in case:
            raise GateFailure(f"{name} is missing its mandatory marker", 2)
        expected = EXPECTED_CASES[name]
        if set(case) != set(expected):
            raise GateFailure(f"{name} fields differ from production contract", 2)
        for field, value in expected.items():
            if case.get(field) != value:
                raise GateFailure(f"{name} {field} changed from reviewed value", 2)
    return cases


def safe_relative(value: str) -> PurePosixPath:
    path = PurePosixPath(value)
    if path.is_absolute() or not path.parts or any(part in ("", ".", "..") for part in path.parts):
        raise GateFailure(f"unsafe fixture manifest path: {value!r}", 2)
    return path


def validate_sha_manifest_data(
    manifest: bytes,
    files: dict[str, bytes],
    expected_manifest_sha256: str,
) -> dict[str, str]:
    if sha256(manifest) != expected_manifest_sha256:
        raise GateFailure("fixture SHA256SUMS changed from reviewed digest", 2)
    try:
        lines = manifest.decode("ascii").splitlines()
    except UnicodeDecodeError as error:
        raise GateFailure("fixture SHA256SUMS must be ASCII", 2) from error
    entries: dict[str, str] = {}
    for line in lines:
        if len(line) < 67 or line[64:66] != "  " or not SHA256.fullmatch(line[:64]):
            raise GateFailure(f"malformed SHA256SUMS line: {line!r}", 2)
        relative = safe_relative(line[66:]).as_posix()
        if relative in entries:
            raise GateFailure(f"duplicate SHA256SUMS path: {relative}", 2)
        entries[relative] = line[:64]
    if not entries or list(entries) != sorted(entries):
        raise GateFailure("fixture SHA256SUMS paths must be nonempty and sorted", 2)
    if set(entries) != set(files):
        raise GateFailure("fixture SHA256SUMS path set differs from loaded fixtures", 2)
    for relative, expected in entries.items():
        if sha256(files[relative]) != expected:
            raise GateFailure(f"fixture SHA-256 mismatch: {relative}", 2)
    return entries


def root_path(relative: str) -> Path:
    safe_relative(relative)
    path = (ROOT / relative).resolve()
    if ROOT != path and ROOT not in path.parents:
        raise GateFailure(f"fixture path escapes repository: {relative}", 2)
    return path


def verify_semantic_inputs(cases: list[dict[str, Any]]) -> dict[str, Any]:
    evidence: dict[str, Any] = {}
    for case in cases:
        name = case["name"]
        program = root_path(case["program"])
        if not program.is_file():
            raise GateFailure(f"missing expected semantic path: {case['program']}", 2)
        program_digest = sha256(program.read_bytes())
        if program_digest != case["program_sha256"]:
            raise GateFailure(f"{name} program SHA-256 changed", 2)
        item: dict[str, Any] = {
            "program": case["program"],
            "program_sha256": program_digest,
        }
        manifest_name = case["fixture_manifest"]
        if manifest_name is not None:
            manifest_path = root_path(manifest_name)
            if not manifest_path.is_file():
                raise GateFailure(f"missing expected fixture manifest: {manifest_name}", 2)
            manifest_bytes = manifest_path.read_bytes()
            files: dict[str, bytes] = {}
            try:
                manifest_lines = manifest_bytes.decode("ascii").splitlines()
            except UnicodeDecodeError as error:
                raise GateFailure(f"{manifest_name} must be ASCII", 2) from error
            for line in manifest_lines:
                if len(line) < 67:
                    raise GateFailure(f"malformed fixture manifest: {manifest_name}", 2)
                relative = safe_relative(line[66:]).as_posix()
                fixture = (manifest_path.parent / relative).resolve()
                if manifest_path.parent not in fixture.parents:
                    raise GateFailure(f"fixture escapes manifest root: {relative}", 2)
                if not fixture.is_file():
                    raise GateFailure(f"missing fixture listed by manifest: {relative}", 2)
                files[relative] = fixture.read_bytes()
            entries = validate_sha_manifest_data(
                manifest_bytes,
                files,
                case["fixture_manifest_sha256"],
            )
            item["fixture_manifest"] = manifest_name
            item["fixture_manifest_sha256"] = sha256(manifest_bytes)
            item["fixture_count"] = len(entries)
        golden_name = case["raw_golden_path"]
        item["raw_golden_sha256"] = case["raw_golden_sha256"]
        if golden_name is not None:
            golden = root_path(golden_name)
            if not golden.is_file():
                raise GateFailure(f"missing expected semantic path: {golden_name}", 2)
            golden_bytes = golden.read_bytes()
            if sha256(golden_bytes) != case["raw_golden_sha256"]:
                raise GateFailure(f"{name} raw golden SHA-256 changed", 2)
            item["raw_golden_path"] = golden_name
            item["raw_golden_sha256"] = sha256(golden_bytes)
        evidence[name] = item
    return evidence


def checkout_path(name: str, entry: dict[str, Any]) -> Path:
    override = os.environ.get(CHECKOUT_ENV[name])
    return Path(override).expanduser().resolve() if override else CACHE / entry["destination"]


def checkout_is_overridden(name: str) -> bool:
    """True when URDR_*_CHECKOUT points at a local tree (not the cache pin)."""
    return bool(os.environ.get(CHECKOUT_ENV.get(name, ""), "").strip())


def validate_checkout_commit(
    name: str,
    actual: str,
    dirty: bool = False,
    *,
    allow_unpinned: bool = False,
) -> None:
    """Enforce lock pin unless allow_unpinned (local URDR_*_CHECKOUT override).

    Local port development trees (e.g. shen-lua perf branch) intentionally
    diverge from the lock; the override path records the actual HEAD in
    evidence instead of failing the pin equality check. Dirty trees still
    fail closed so evidence is reproducible.
    """
    if dirty:
        raise GateFailure(f"{name} checkout has modified tracked files", 2)
    if allow_unpinned:
        return
    if actual != EXPECTED_PINS[name]:
        raise GateFailure(
            f"{name} checkout is {actual}, expected {EXPECTED_PINS[name]}",
            2,
        )


def git_output(checkout: Path, *arguments: str) -> str:
    try:
        return subprocess.run(
            ["git", *arguments],
            cwd=checkout,
            check=True,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError) as error:
        raise GateFailure(f"cannot inspect pinned checkout {checkout}: {error}", 2) from error


def verify_checkouts(
    entries: dict[str, dict[str, Any]],
    required: tuple[str, ...],
    shake: bool = False,
) -> tuple[dict[str, Path], dict[str, dict[str, Any]]]:
    paths: dict[str, Path] = {}
    evidence: dict[str, dict[str, Any]] = {}
    tools = ("bifrost", "ratatoskr") if shake else ("bifrost",)
    for name in (*tools, *required):
        checkout = checkout_path(name, entries[name])
        if not checkout.is_dir():
            raise GateFailure(f"missing pinned checkout for {name}: {checkout}", 2)
        actual = git_output(checkout, "rev-parse", "HEAD")
        dirty_result = subprocess.run(
            ["git", "diff", "--quiet", "HEAD", "--"],
            cwd=checkout,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if dirty_result.returncode > 1:
            raise GateFailure(f"cannot verify tracked state for {name}", 2)
        unpinned = name not in ("bifrost", "ratatoskr") and checkout_is_overridden(name)
        validate_checkout_commit(
            name,
            actual,
            dirty_result.returncode == 1,
            allow_unpinned=unpinned,
        )
        paths[name] = checkout
        item: dict[str, Any] = {"commit": actual, "checkout": str(checkout)}
        if unpinned:
            item["unpinned"] = True
            item["lock_commit"] = EXPECTED_PINS[name]
        evidence[name] = item
    evidence["shenscript"] = {
        "commit": EXPECTED_PINS["shenscript"],
        "required": False,
    }
    return paths, evidence


def verify_launcher_provenance(name: str, checkout: Path) -> str:
    """Prove the launcher was built from the commit the checkout is pinned to.

    Content-addressed rather than mtime-based, to match how the checkouts
    themselves are verified: the stamp records a commit, and a commit is a
    hash of the tree it names. A missing stamp is a hard failure -- treating it
    as "probably fine" is exactly the fail-open this check exists to close.
    """
    stamp = checkout / BUILD_STAMP
    if not stamp.is_file():
        raise GateFailure(
            f"{name} launcher has no build stamp at {stamp}; "
            f"run `make ports` so the binary is built from the pinned commit",
            2,
        )
    try:
        recorded = stamp.read_text(encoding="utf-8").strip()
    except OSError as error:
        raise GateFailure(f"cannot read {name} build stamp: {error}", 2) from error
    if not FULL_SHA.match(recorded):
        raise GateFailure(
            f"{name} build stamp is not a full commit sha: {recorded!r}", 2
        )
    actual = git_output(checkout, "rev-parse", "HEAD")
    if recorded != actual:
        raise GateFailure(
            f"{name} launcher was built from {recorded} but the checkout is at "
            f"{actual}; run `make ports` to rebuild against the pin",
            2,
        )
    return recorded


def resolve_launchers(
    paths: dict[str, Path],
    required: tuple[str, ...],
) -> dict[str, Path]:
    launchers: dict[str, Path] = {}
    for name in required:
        path = paths[name] / LAUNCHERS[name]
        if not path.is_file() or not os.access(path, os.X_OK):
            raise GateFailure(f"missing executable launcher for {name}: {path}", 2)
        verify_launcher_provenance(name, paths[name])
        launchers[name] = path
        os.environ[BIFROST_LAUNCHER_ENV[name]] = str(path)
    return launchers


def resolve_shake_targets(paths: dict[str, Path], required: tuple[str, ...]) -> None:
    """Point Ratatoskr at the pinned checkouts for stage 1 and stage 2.

    Without this the shaker falls back to sibling directories on disk, and the
    lane would silently attest to whatever happened to be next to it instead of
    the reviewed commits.
    """
    binary = paths["ratatoskr"] / "ratatoskr"
    if binary.is_file() and os.access(binary, os.X_OK):
        os.environ["BIFROST_RATATOSKR_BIN"] = str(binary)
    os.environ["BIFROST_RATATOSKR_DIR"] = str(paths["ratatoskr"])
    for name in required:
        os.environ[RATATOSKR_DIR_ENV[name]] = str(paths[name])


def resolve_heavy_timeout() -> int:
    """Seconds allowed per heavy case, from URDR_BIFROST_HEAVY_TIMEOUT."""
    raw = os.environ.get("URDR_BIFROST_HEAVY_TIMEOUT", str(HEAVY_TIMEOUT_DEFAULT))
    try:
        heavy = int(raw)
    except ValueError:
        raise GateFailure(
            f"URDR_BIFROST_HEAVY_TIMEOUT must be an integer, got {raw!r}", 2
        ) from None
    if not HEAVY_TIMEOUT_MIN <= heavy <= HEAVY_TIMEOUT_MAX:
        raise GateFailure(
            f"URDR_BIFROST_HEAVY_TIMEOUT must be "
            f"{HEAVY_TIMEOUT_MIN}..{HEAVY_TIMEOUT_MAX}, got {heavy}",
            2,
        )
    return heavy


def apply_heavy_timeout(module: ModuleType, heavy: int) -> None:
    """Raise the pinned Bifrost's heavy-case timeout without editing it.

    Urdr heavy cases are pure-Shen (software SHA-256). Bifrost's stock 300s
    heavy timeout is enough for its own corpus, but not for
    replay-certificate's 100-replay identity loop on shen-rust.

    Rebinding module.TIMEOUT_HEAVY alone is not enough: execute_cases takes
    `heavy_timeout=TIMEOUT_HEAVY` as a default argument, bound at import, and
    run_suite never passes it explicitly. Bind the keyword on the module
    attribute instead -- run_suite resolves execute_cases as a global at call
    time, so the partial takes effect while the pinned bifrost.py stays
    pristine. TIMEOUT_HEAVY is still set for the call-time readers.
    """
    module.TIMEOUT_HEAVY = heavy
    module.execute_cases = functools.partial(module.execute_cases, heavy_timeout=heavy)


def import_bifrost(path: Path, heavy: int) -> ModuleType:
    runner = path / "bifrost.py"
    if not runner.is_file():
        raise GateFailure(f"pinned Bifrost runner is missing: {runner}", 2)
    spec = importlib.util.spec_from_file_location("urdr_pinned_bifrost", runner)
    if spec is None or spec.loader is None:
        raise GateFailure("cannot construct pinned Bifrost module", 2)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    apply_heavy_timeout(module, heavy)
    return module


def validate_versions(versions: dict[str, str], required: tuple[str, ...]) -> None:
    if set(versions) != set(required):
        raise GateFailure(
            "live version probes do not cover exactly the required ports"
        )
    for name in required:
        if versions[name] != KERNEL_VERSION:
            raise GateFailure(
                f"{name} reported kernel {versions[name]!r}, expected 41.2"
            )


def semantic_projection(case_name: str, raw: bytes) -> bytes:
    prefixes = {
        "canonical-values": (b"valid|", b"reject|", b"FAIL|"),
        "named-prng": (b"PASS ", b"FAIL ", b"urdr-prng:"),
        "world-reducer": (
            b"WORLD-CHOICE-DRAWN ", b"WORLD-CHOICE-SELECTED ",
            b"WORLD-TRACE ", b"WORLD-COMPONENT-TRACE ", b"WORLD TESTS:",
            b"WORLD TRACE:"),
        "scenario-parse": (
            b"profile|", b"accept|", b"large|", b"reject|", b"FAIL|",
            b"urdr-scenario: "),
        "netkat-core": (
            b"NETKAT-OK|", b"NETKAT-REJECT|", b"NETKAT-FLIP|",
            b"NETKAT-DIRECT|", b"NETKAT CASES: ", b"NETKAT DIRECT: "),
        "netpol-compile": (
            b"NETPOL-OK|", b"NETPOL-TERM|", b"NETPOL-REJECT|",
            b"NETPOL-FLIP|", b"NETPOL-DIRECT|", b"NETPOL CASES: ",
            b"NETPOL DIRECT: ", b"NETPOL MARKER: "),
        "models-conformance": (
            b"MODELS-OK|", b"MODELS-DIGEST|", b"MODELS-REJECT|",
            b"MODELS-DIRECT|", b"MODELS CASES: "),
        "property-verdicts": (
            b"PROP|", b"SLOT|", b"MUT|", b"LOAD|", b"TRACE|", b"FAIL|",
            b"PROPERTIES CASES: ", b"PROPERTIES: FAIL"),
        "replay-certificate": (
            b"NODES|", b"CA|", b"EL|", b"ELT|", b"ELC|", b"RT|", b"E2E|",
            b"PROP|", b"SIG|", b"DIV|", b"DIVD|", b"MUT|", b"MARK|",
            b"CERT|", b"CERTS|", b"CERTD|", b"CERTF|", b"LOOP|", b"FAIL|",
            b"REPLAY CASES: ", b"REPLAY: FAIL"),
        "explore-shrink": (
            b"CHOICE|", b"STRAT|", b"EXPLORE|", b"SHRINK|", b"MUT|",
            b"REPLAY|", b"SEED|", b"FAIL|", b"EXPLORE-SHRINK CASES: "),
        "scenario-grammar": (
            b"SEED|", b"MUT|", b"REPLAY|", b"FAIL|", b"GRAMMAR CASES: "),
        "m1-integration": (
            b"DEMO|", b"FAIL|", b"INTEGRATION CASES: "),
        "run-driver": (
            b"RUN|", b"FAIL|", b"RUN CASES: "),
    }[case_name]
    lines = [
        line
        for line in raw.splitlines()
        if line == b"ALL PASS" or line.startswith(prefixes)
    ]
    return b"\n".join(lines) + (b"\n" if lines else b"")


def validate_output_shape(case_name: str, semantic: bytes) -> None:
    try:
        lines = semantic.decode("ascii").splitlines()
    except UnicodeDecodeError as error:
        raise GateFailure(f"{case_name} semantic output must be ASCII") from error
    if not lines or lines[-1] != "ALL PASS":
        raise GateFailure(f"{case_name} raw marker is missing")
    if case_name == "property-verdicts":
        for line in lines[:-1]:
            if line == "PROPERTIES: FAIL" or line.startswith("FAIL|"):
                raise GateFailure(f"{case_name} raw output contains failure")
    elif case_name == "replay-certificate":
        for line in lines[:-1]:
            if line == "REPLAY: FAIL" or line.startswith("FAIL|"):
                raise GateFailure(f"{case_name} raw output contains failure")
    elif case_name in (
        "explore-shrink",
        "scenario-grammar",
        "m1-integration",
        "run-driver",
    ):
        for line in lines[:-1]:
            if line.startswith("FAIL|"):
                raise GateFailure(f"{case_name} raw output contains failure")
    else:
        if any("FAIL" in line for line in lines[:-1]):
            raise GateFailure(f"{case_name} raw output contains failure")
    if case_name == "canonical-values":
        valid = re.compile(r"^valid\|[a-z0-9-]+\|[0-9a-f]+$")
        reject = re.compile(r"^reject\|[a-z0-9-]+\|[a-z0-9-]+$")
        if (
            len(lines) != 53
            or sum(bool(valid.fullmatch(line)) for line in lines[:-1]) != 20
            or sum(bool(reject.fullmatch(line)) for line in lines[:-1]) != 32
        ):
            raise GateFailure("canonical raw output shape or lowercase hex changed")
    elif case_name == "named-prng":
        passes = [line for line in lines if line.startswith("PASS ")]
        summaries = [
            line for line in lines if re.fullmatch(r"urdr-prng: ([0-9]+)/\1 passed", line)
        ]
        if len(summaries) != 1:
            raise GateFailure("PRNG raw output summary changed")
        count = int(summaries[0].split()[1].split("/")[0])
        if len(passes) != count or len(lines) != count + 2:
            raise GateFailure("PRNG raw output test count changed")
    elif case_name == "world-reducer":
        # The two choice digests pin the ADR 0007 D2 round-trip theorem:
        # a drawn choice and its pinned (selected-form) replay emit the
        # same record, so the digests must be equal, not merely present.
        if (
            len(lines) != 6
            or not re.fullmatch(r"WORLD-CHOICE-DRAWN [0-9a-f]+", lines[0])
            or not re.fullmatch(r"WORLD-CHOICE-SELECTED [0-9a-f]+", lines[1])
            or lines[0].split(" ")[1] != lines[1].split(" ")[1]
            or not re.fullmatch(r"WORLD-TRACE [0-9a-f]+", lines[2])
            or not re.fullmatch(r"WORLD-COMPONENT-TRACE [0-9a-f]+", lines[3])
            or lines[4] != "WORLD TESTS: 26/26 PASS"
        ):
            raise GateFailure("world raw output or lowercase trace changed")


def validate_execution(
    available_names: list[str],
    skipped: dict[str, str],
    case_results: dict[str, dict[str, Any]],
    versions: dict[str, str],
    golden_loader: Callable[[str], bytes],
    expected_output_hashes: dict[str, str] | None = None,
    required: tuple[str, ...] = REQUIRED_IMPLS,
) -> dict[str, Any]:
    if not required:
        raise GateFailure("required implementation matrix is empty")
    if set(available_names) != set(required):
        raise GateFailure("Bifrost available matrix differs from required ports")
    missing = [name for name in required if name in skipped]
    if missing:
        raise GateFailure("Bifrost skipped required ports: " + ",".join(missing))
    validate_versions(versions, required)
    if set(case_results) != set(CASE_ORDER):
        raise GateFailure("Bifrost result does not contain all semantic cases")
    output_hashes = expected_output_hashes or {
        name: EXPECTED_CASES[name]["raw_golden_sha256"] for name in CASE_ORDER
    }

    evidence: dict[str, Any] = {}
    for case_name in CASE_ORDER:
        result = case_results[case_name]
        if result.get("verdict") == "DIVERGE":
            raise GateFailure(f"{case_name} reported DIVERGE")
        if result.get("verdict") != "PASS":
            raise GateFailure(
                f"{case_name} Bifrost verdict is {result.get('verdict')!r}"
            )
        per_impl = result.get("per_impl")
        if not isinstance(per_impl, dict) or set(per_impl) != set(required):
            raise GateFailure(
                f"{case_name} does not contain exactly the required ports"
            )
        raw_outputs: dict[str, bytes] = {}
        semantic_outputs: dict[str, bytes] = {}
        ports: dict[str, Any] = {}
        for name in required:
            port = per_impl[name]
            status = port.get("status")
            if status in ("SKIP", "DIVERGE"):
                raise GateFailure(f"{case_name}/{name} reported {status}")
            if status != "PASS":
                raise GateFailure(f"{case_name}/{name} status is {status!r}")
            if port.get("timeout") or port.get("rc") != 0:
                raise GateFailure(f"{case_name}/{name} did not exit cleanly")
            raw_text = port.get("raw")
            if not isinstance(raw_text, str) or "\ufffd" in raw_text:
                raise GateFailure(f"{case_name}/{name} raw output is not strict UTF-8")
            raw = raw_text.encode("utf-8")
            semantic = semantic_projection(case_name, raw)
            validate_output_shape(case_name, semantic)
            raw_outputs[name] = raw
            semantic_outputs[name] = semantic
            ports[name] = {
                "status": status,
                "exit_code": port["rc"],
                "raw_direct_output_sha256": sha256(raw),
                "raw_semantic_output_sha256": sha256(semantic),
                "raw_semantic_bytes": len(semantic),
            }
        if len(set(semantic_outputs.values())) != 1:
            raise GateFailure(f"{case_name} raw direct semantic outputs disagree")
        agreed = semantic_outputs[required[0]]
        if sha256(agreed) != output_hashes[case_name]:
            raise GateFailure(f"{case_name} raw direct output differs from golden SHA")
        golden_name = EXPECTED_CASES[case_name]["raw_golden_path"]
        if golden_name is not None and agreed != golden_loader(golden_name):
            raise GateFailure(f"{case_name} raw direct output differs from golden")
        evidence[case_name] = {
            "bifrost_verdict": "PASS",
            "marker": "ALL PASS",
            "raw_direct_agreement_sha256": sha256(agreed),
            "ports": ports,
        }
    return evidence


def bundle_programs(destination: Path) -> dict[str, str]:
    """Write a shakeable single-file bundle per reviewed case.

    Ratatoskr is a static shaker and follows neither of the ways urdr suites
    pull modules in, so the shake lane runs bundles rather than the suites
    themselves; scripts/bundle-shake-program explains why. The bundles are
    generated here rather than committed so they cannot drift from the sources
    they are built out of. Their digests go into the evidence.
    """
    loader = importlib.machinery.SourceFileLoader(
        "urdr_bundle_shake", str(ROOT / "scripts" / "bundle-shake-program")
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise GateFailure("cannot load scripts/bundle-shake-program", 2)
    bundler = importlib.util.module_from_spec(spec)
    loader.exec_module(bundler)

    digests: dict[str, str] = {}
    for name in CASE_ORDER:
        program = EXPECTED_CASES[name]["program"]
        try:
            text = bundler.bundle(program)
        except Exception as error:  # bundler raises its own BundleError type
            raise GateFailure(f"cannot bundle {name}: {error}", 2) from error
        path = destination / f"{name}.shen"
        path.write_text(text, encoding="utf-8")
        digests[name] = sha256(path.read_bytes())
    return digests


def execute(
    module: ModuleType,
    required: tuple[str, ...],
    shake: bool = False,
    bundle_dir: Path | None = None,
) -> tuple[dict[str, Any], dict[str, str], dict[str, str]]:
    suite = module.build_suite_from_manifest(str(SUITE_PATH))
    if shake:
        # Point every case at its bundle; Bifrost shakes case["program"].
        if bundle_dir is None:
            raise GateFailure("shake lane requires a bundle directory", 2)
        for case in suite["inline_cases"]:
            case["program"] = str(bundle_dir / f"{case['name']}.shen")
    _, case_results, available, skipped, cases = module.run_suite(
        suite,
        restrict=set(required),
        include_heavy=True,
        progress=False,
        shake=shake,
    )
    if [case.get("name") for case in cases] != list(CASE_ORDER):
        raise GateFailure("Bifrost did not load the reviewed semantic case set")
    versions: dict[str, str] = {}
    version_case = {
        "mode": "version",
        "expect": "version",
        "contains": KERNEL_VERSION,
    }
    for name in available:
        result = module.run_case_on_impl(
            name,
            available[name],
            version_case,
            module.TIMEOUT_HEAVY,
            suite,
        )
        if result.get("timeout") or result.get("rc") != 0:
            raise GateFailure(f"{name} live kernel-version probe failed")
        match = re.search(r"\b(\d+\.\d+)\b", result.get("raw", ""))
        versions[name] = match.group(1) if match else "unknown"
    case_evidence = validate_execution(
        list(available),
        skipped,
        case_results,
        versions,
        lambda relative: root_path(relative).read_bytes(),
        required=required,
    )
    return case_evidence, skipped, versions


def main() -> int:
    evidence: dict[str, Any] = {
        "schema_version": 1,
        "gate": "urdr-m0-strict-bifrost",
        "status": "ERROR",
        "kernel_version": KERNEL_VERSION,
    }
    try:
        if os.environ.get("URDR_OFFLINE") != "1":
            raise GateFailure("gate must run with URDR_OFFLINE=1", 2)
        os.environ["SHEN_KERNEL_CACHE"] = "off"
        os.environ["SHEN_FASL"] = "off"
        required = parse_required_impls(
            os.environ.get("REQUIRED_IMPLS", ",".join(REQUIRED_IMPLS))
        )
        evidence["required_implementations"] = list(required)
        shake = os.environ.get("URDR_SHAKE") == "1"
        if shake:
            evidence["gate"] = "urdr-m1-strict-bifrost-shake"
            evidence["lane"] = "shake"
        heavy_timeout = resolve_heavy_timeout()
        evidence["bifrost_heavy_timeout"] = heavy_timeout
        entries = load_and_validate_locks()
        cases = validate_manifest(load_json(SUITE_PATH))
        input_evidence = verify_semantic_inputs(cases)
        paths, dependency_evidence = verify_checkouts(entries, required, shake)
        launchers = resolve_launchers(paths, required)
        # Record which build each port actually ran, not just which commit was
        # checked out. Without this the evidence cannot distinguish a run
        # against the pinned code from a run against a stale binary.
        for name in required:
            dependency_evidence[name]["launcher"] = str(launchers[name])
            dependency_evidence[name]["built_from"] = (
                (paths[name] / BUILD_STAMP).read_text(encoding="utf-8").strip()
            )
        module = import_bifrost(paths["bifrost"], heavy_timeout)
        if shake:
            resolve_shake_targets(paths, required)
            with tempfile.TemporaryDirectory(prefix="urdr-shake-") as tmp:
                bundle_dir = Path(tmp)
                evidence["shake_bundles"] = bundle_programs(bundle_dir)
                case_evidence, skipped, versions = execute(
                    module, required, shake=True, bundle_dir=bundle_dir
                )
        else:
            case_evidence, skipped, versions = execute(module, required)
        evidence.update(
            {
                "status": "PASS",
                "suite_sha256": sha256(SUITE_PATH.read_bytes()),
                "semantic_inputs": input_evidence,
                "dependencies": dependency_evidence,
                "launchers": {name: str(path) for name, path in launchers.items()},
                "live_kernel_versions": versions,
                "skipped": skipped,
                "cases": case_evidence,
            }
        )
        print(json.dumps(evidence, indent=2, sort_keys=True))
        return 0
    except GateFailure as error:
        evidence["status"] = "FAIL" if error.exit_code == 1 else "ERROR"
        evidence["errors"] = [str(error)]
        print(json.dumps(evidence, indent=2, sort_keys=True))
        return error.exit_code
    except Exception as error:  # Fail closed on unexpected Bifrost/tool failures.
        evidence["errors"] = [f"unexpected gate failure: {type(error).__name__}: {error}"]
        print(json.dumps(evidence, indent=2, sort_keys=True))
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
