# Runtime and test artifacts
artifacts/
*.log
*.pid
# shen-lua and shen-cl drop this in the working directory on load; untracked
# and unignored, it makes scripts/check-clean-tree fail the moment any suite
# regenerates it. shen-lua names it per Lua build
# (.shen-kernel-cache.<hash>.bin); older builds wrote .shen-kernel-cache.bin.
.shen-kernel-cache*.bin
spikes/m1-prolog-portability/out/

# Claude Code session worktrees
.claude/
